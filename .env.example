# ---------------------------------------------------------------------------
# Local development. See docs/PRODUCTION.md for every setting.
# ---------------------------------------------------------------------------

# "dev" (default) or "prod". prod refuses to start without JWT auth, a real
# verification key, Postgres and Redis.
ENV=dev

# Auth: "dev" exposes POST /api/dev/token so the demo UI can act as any seeded
# customer. Production uses "jwt" with tokens issued by your site.
AUTH_MODE=dev
# JWT_SECRET=            # HS256 shared secret (≥32 random bytes), or:
# JWT_JWKS_URL=          # your IdP's JWKS endpoint (RS256/ES256)
# JWT_ISSUER=
# JWT_AUDIENCE=

# Which LLM provider the agent uses: "anthropic", "openai", or "fake"
# (scripted, no key needed — used for load tests).
LLM_PROVIDER=anthropic
# LLM_FALLBACK_PROVIDER=openai

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Storage. docker compose provides Postgres + Redis automatically. For a bare
# `uvicorn` run you can leave these unset: SQLite + an in-process Redis stand-in
# are used (single process only), and SEED_ON_STARTUP creates the demo data.
# DATABASE_URL=postgresql://acme:acme@localhost:5432/acme
# REDIS_URL=redis://localhost:6379/0
# SEED_ON_STARTUP=true

# --- Guardrails (see docs/HARDENING.md). All optional; defaults shown. ---
# MAX_MESSAGE_CHARS=2000
# MAX_CONVERSATION_TURNS=30
# MAX_CONVERSATION_TOKENS=60000
# CUSTOMER_DAILY_TOKEN_BUDGET=300000
# AGENT_RECURSION_LIMIT=12
# MAX_OUTPUT_TOKENS=1024
# CHAT_RATE_LIMIT=10/minute          # per customer
# MAX_CONCURRENT_TURNS=200           # global back-pressure (503 beyond this)
# TURN_TIMEOUT_S=120
